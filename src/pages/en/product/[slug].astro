---
import Base from '../../../layouts/Base.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import Badge from '../../../components/Badge.astro';
import ProductCard from '../../../components/ProductCard.astro';
import ProductGallery from '../../../components/ProductGallery.astro';
import RatingBadge from '../../../components/RatingBadge.astro';
import { loadProducts, localizedTitle, productSlug, type Product } from '@lib/products';
import { productJsonLd, breadcrumbJsonLd } from '@lib/jsonld';
import { loadReviews, pickReviews, formatRating } from '@lib/reviews';
import { displayPrice, FALLBACK_RATES, productRates, effectiveUsdRate } from '@lib/currency';
import { optName, optValue } from '@lib/optionLabels';
import { categoryLabel } from '@lib/categories';
import { pricesHidden, whatsappUrl, instagramUrl } from '@lib/pricing';
import settings from '../../../data/settings.json';

export function getStaticPaths() {
  return loadProducts().map((p) => ({ params: { slug: productSlug(p, 'en') }, props: { product: p } }));
}
const { product } = Astro.props as { product: Product };
const gallery = product.images?.length ? product.images : (product.image ? [product.image] : []);
const site = Astro.site!.toString().replace(/\/+$/, '');
const selfPath = `product/${productSlug(product, 'en')}`;
const trSlug = productSlug(product, 'tr');
const title = localizedTitle(product, 'en');
const rates = (settings as any).rates ?? FALLBACK_RATES;
const price = displayPrice(product.price, 'en', productRates(product.price, product.priceUsd, rates));
const enUsdRate = effectiveUsdRate(product.price, product.priceUsd, rates.usd);
const related = loadProducts().filter((x) => x.category === product.category && x.id !== product.id).slice(0, 4);
const reviewsData = loadReviews();
const shop = reviewsData.shop;
// Verified Etsy shop reviews, EN-language first — strong buy-signal below the description.
const shopReviews = pickReviews(reviewsData.reviews, 'en', 4);
const ld = productJsonLd(product, 'en', `${site}/en/${selfPath}`, shop.rating ? { value: shop.rating, count: shop.count } : undefined, productRates(product.price, product.priceUsd, rates));
const crumbLd = breadcrumbJsonLd([
  { name: 'Home', url: `${site}/en` },
  { name: 'Products', url: `${site}/en/products` },
  { name: title, url: `${site}/en/${selfPath}` },
]);
const hideP = pricesHidden();
const waHref = whatsappUrl(title, `${site}/en/${selfPath}`, 'en');
const igHref = instagramUrl();
---
<Base locale="en" title={`${title} — Aselovers`} description={(product.description_en || title).split('\n')[0]}
  pathSelf={selfPath} pathsAlt={{ tr: `urun/${trSlug}`, en: selfPath }} ogImage={product.image ?? undefined}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={ld} />
    <script type="application/ld+json" set:html={crumbLd} />
  </Fragment>
  <Nav locale="en" />
  <main>
    <section class="section detail-section">
      <div class="container">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/en">Home</a><span aria-hidden="true">/</span>
          <a href="/en/products">Products</a><span aria-hidden="true">/</span>
          <span class="crumbs__current">{title}</span>
        </nav>

        <div class="detail">
          <div class="detail__gallery">
            <ProductGallery images={gallery} alt={product.imageAlt || title} />
          </div>

          <div class="detail__info">
            {product.category && <p class="detail__eyebrow">{categoryLabel(product.category, 'en')}</p>}
            <h1 class="detail__title">{title}</h1>
            <div class="detail__meta">
              <RatingBadge rating={shop.rating} count={shop.count} locale="en" />
              {product.isNew && <Badge>New</Badge>}
            </div>

            <div class="buybox">
              {hideP ? (
                <div class="buybox__pricerow">
                  <span class="handmade-tag handmade-tag--solo">
                    <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-8-4.5-8-10a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 11c0 5.5-8 10-8 10z"/></svg>
                    Handmade
                  </span>
                </div>
              ) : (
              <div class="buybox__pricerow">
                <span class="detail__price" id="detail-price" data-usd-rate={enUsdRate}>{price}</span>
                <span class="detail__vat">VAT included</span>
                <span class="handmade-tag">
                  <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-8-4.5-8-10a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 11c0 5.5-8 10-8 10z"/></svg>
                  Handmade
                </span>
              </div>
              )}

              <div class="stitch" aria-hidden="true">
                <svg viewBox="0 0 240 8" preserveAspectRatio="none" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-dasharray="7 5"><path d="M2 4 Q10 -1 20 4 T40 4 T60 4 T80 4 T100 4 T120 4 T140 4 T160 4 T180 4 T200 4 T220 4 T238 4"/></svg>
              </div>

              <p class="leadtime">
                <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg>
                <span><strong>Preparation time: 7–10 days.</strong> Every piece is made by hand, so it is crocheted in about 7–10 days; delivery then takes 1–3 days across Türkiye (7–14 days internationally).</span>
              </p>

              {product.options && product.options.length > 0 && (
                <div class="variations" id="variations">
                  {product.options.map((opt) => (
                    <div class="variation">
                      <label class="variation__label">{optName(opt.name, 'en')}</label>
                      <div class="select-wrap">
                        <select class="variation__sel" data-name={opt.name} required>
                          <option value="" disabled selected>Select…</option>
                          {opt.values.map((v) => <option value={v}>{optValue(v, 'en')}</option>)}
                        </select>
                        <svg class="select-wrap__caret" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
                      </div>
                    </div>
                  ))}
                  <p class="variation__err" id="variation-err" hidden>Please choose all options.</p>
                </div>
              )}

              <div class="personalize" id="personalize" hidden>
                <label class="variation__label" for="personalize-name">Name to embroider ✎</label>
                <input type="text" id="personalize-name" maxlength="30" autocomplete="off" placeholder="e.g. Emily" />
                <p class="variation__err" id="personalize-err" hidden>Please enter the name to embroider.</p>
              </div>

              {product.customFields && product.customFields.length > 0 && (
                <div class="personalize" id="custom-fields">
                  {product.customFields.map((f, i) => (
                    <div class="cfield">
                      <label class="variation__label" for={`cfield-${i}`}>{f.label}{f.required ? ' *' : ''}</label>
                      <input type="text" id={`cfield-${i}`} data-label={f.label} data-required={f.required ? '1' : ''} maxlength="60" autocomplete="off" />
                    </div>
                  ))}
                  <p class="variation__err" id="cfield-err" hidden>Please fill in the required fields.</p>
                </div>
              )}

              <div class="ordernote">
                <label class="variation__label" for="order-note">Your request or note ✎ <span class="ordernote__opt">(optional)</span></label>
                <textarea id="order-note" rows="3" maxlength="300" autocomplete="off"
                  placeholder="Colour preference, name to embroider, gift message, delivery date… anything you like."></textarea>
                <p class="ordernote__hint"><span id="order-note-count">0</span>/300 · Your note reaches us with the order.</p>
              </div>

              {hideP ? (
                <div class="dmbuy">
                  <div class="dmbuy__row">
                    <a class="dmbuy__btn dmbuy__btn--wa" id="wa-btn" href={waHref} data-title={title} data-url={`${site}/en/${selfPath}`} target="_blank" rel="noopener">
                      <svg class="seam" aria-hidden="true"><rect/></svg>
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.3-1.38a9.86 9.86 0 0 0 4.73 1.2c5.46 0 9.9-4.44 9.9-9.9 0-2.64-1.03-5.13-2.9-7A9.82 9.82 0 0 0 12.04 2Zm3.47 12.02c-.2.56-1.17 1.08-1.64 1.15-.42.06-.95.08-1.53-.1-.35-.11-.8-.26-1.38-.51-2.44-1.04-4.02-3.48-4.14-3.64-.12-.16-.99-1.31-.99-2.51 0-1.19.63-1.78.85-2.02.22-.24.48-.3.64-.3h.46c.17.01.36.01.54.43.22.48.7 1.68.76 1.8.06.12.1.26.02.42-.08.16-.12.26-.24.4-.12.14-.25.31-.36.42-.12.12-.25.25-.11.49.15.24.63 1.04 1.35 1.68.93.82 1.71 1.08 1.95 1.2.24.12.38.1.52-.06.14-.16.61-.71.77-.95.17-.24.33-.2.55-.12.22.08 1.42.67 1.66.79.24.12.4.18.46.28.06.1.06.58-.14 1.15Z"/></svg>
                      Ask on WhatsApp
                    </a>
                    <a class="dmbuy__btn dmbuy__btn--ig" href={igHref} target="_blank" rel="noopener">
                      <svg class="seam" aria-hidden="true"><rect/></svg>
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
                      Message on Instagram
                    </a>
                  </div>
                  <p class="dmbuy__hint">Anything you type above is added to the message automatically.</p>
                </div>
              ) : (
              <div class="detail__buy">
                <div class="qtystep" role="group" aria-label="Quantity">
                  <button type="button" class="qtystep__btn" id="qty-minus" aria-label="Decrease quantity">−</button>
                  <span class="qtystep__val" id="qty-val" aria-live="polite">1</span>
                  <button type="button" class="qtystep__btn" id="qty-plus" aria-label="Increase quantity">+</button>
                </div>
                <button id="add-to-cart" type="button" class="btn btn--primary detail__cta" data-product={JSON.stringify(product)}>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                  Add to Cart
                </button>
              </div>
              )}

              <ul class="assure">
                <li class="assure__item">
                  <span class="assure__ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 21s-8-4.5-8-10a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 11c0 5.5-8 10-8 10z"/></svg></span>
                  <div><strong>Handmade, just for you</strong><span>Each piece is crocheted to order, one at a time</span></div>
                </li>
                <li class="assure__item">
                  <span class="assure__ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 2l8 3v6c0 5-3.4 9-8 11-4.6-2-8-6-8-11V5z"/><path d="M9 12l2 2 4-4"/></svg></span>
                  <div>{hideP
                    ? <><strong>Quick reply</strong><span>We answer on WhatsApp or Instagram within hours</span></>
                    : <><strong>Secure payment</strong><span>Powered by PayTR — your card details are never stored by us</span></>}</div>
                </li>
                <li class="assure__item">
                  <span class="assure__ic"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="18.5" cy="18.5" r="2"/></svg></span>
                  <div><strong>Careful shipping</strong><span>Tracked delivery across Türkiye and worldwide</span></div>
                </li>
              </ul>
            </div>
          </div>
        </div>

        {product.description_en && (
          <section class="pdesc">
            <h2 class="pdesc__h">Product Details</h2>
            <div class="pdesc__body prose" style="white-space: pre-line">{product.description_en}</div>
          </section>
        )}

        {shopReviews.length > 0 && (
          <section class="previews">
            <h2 class="previews__h">Customer Reviews</h2>
            {shop.rating && shop.count > 0 && (
              <p class="previews__meta">★ {formatRating(shop.rating)} · {shop.count} verified shop reviews</p>
            )}
            <div class="previews__grid">
              {shopReviews.map((r) => (
                <figure class="previews__card">
                  <div class="previews__stars" aria-label={`${r.rating} stars`}>{'★'.repeat(r.rating)}</div>
                  <blockquote class="previews__text">“{r.text}”</blockquote>
                  <figcaption class="previews__date">{r.date}</figcaption>
                </figure>
              ))}
            </div>
          </section>
        )}

        {related.length > 0 && (
          <div class="detail__related">
            <h2 class="detail__related-h">You may also like</h2>
            <div class="detail__related-grid">{related.map((r) => <ProductCard product={r} locale="en" />)}</div>
          </div>
        )}
      </div>
    </section>
  </main>
  <Footer locale="en" />

<script>
  import { addToCart, showCartToast } from '@lib/cart';
  import { resolveVariantPrice } from '@lib/variants';

  let qty = 1;
  const valEl = document.getElementById('qty-val');
  const minus = document.getElementById('qty-minus');
  const plus = document.getElementById('qty-plus');
  const btn = document.getElementById('add-to-cart');
  const priceEl = document.getElementById('detail-price');
  const errEl = document.getElementById('variation-err');
  const sels = Array.from(document.querySelectorAll<HTMLSelectElement>('.variation__sel'));

  const prod = btn ? JSON.parse(btn.getAttribute('data-product') || '{}') : {};
  // Prices are stored in TRY; the EN site shows USD. Convert with the embedded rate.
  const usdRate = Number(priceEl?.getAttribute('data-usd-rate')) || 47.03;
  const fmtPrice = (n: number) => new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(n / usdRate);

  function selected(): Record<string, string> {
    const out: Record<string, string> = {};
    sels.forEach((s) => { if (s.value) out[s.dataset.name || ''] = s.value; });
    return out;
  }
  function allChosen(): boolean { return sels.every((s) => !!s.value); }

  function refreshPrice() {
    if (!priceEl) return;
    const sel = allChosen() ? selected() : undefined;
    priceEl.textContent = fmtPrice(resolveVariantPrice(prod, sel));
  }

  // Merchant-defined custom fields (name to embroider, gift note…) take precedence;
  // otherwise fall back to auto-revealing a single name box for "Personalized" options.
  const cfInputs = Array.from(document.querySelectorAll<HTMLInputElement>('#custom-fields input'));
  const cfErr = document.getElementById('cfield-err');
  const hasCustomFields = cfInputs.length > 0;
  cfInputs.forEach((inp) => inp.addEventListener('input', () => { if (cfErr) cfErr.hidden = true; }));

  // Serbest metin özelleştirme kutusu — her üründe var, opsiyonel. Değeri
  // satırın `note` alanına eklenir; sepette görünür ve siparişle birlikte gider.
  const orderNoteEl = document.getElementById('order-note') as HTMLTextAreaElement | null;
  const orderNoteCount = document.getElementById('order-note-count');
  orderNoteEl?.addEventListener('input', () => {
    if (orderNoteCount) orderNoteCount.textContent = String(orderNoteEl.value.length);
  });
  const personalizeEl = document.getElementById('personalize');
  const nameEl = document.getElementById('personalize-name') as HTMLInputElement | null;
  const nameErr = document.getElementById('personalize-err');
  function isPersonalized(): boolean {
    return sels.some((s) => /personal|kişisel|isim|name/i.test(s.value || ''));
  }
  function updatePersonalize() {
    if (!personalizeEl) return;
    const on = !hasCustomFields && isPersonalized();
    personalizeEl.hidden = !on;
    if (!on && nameEl) nameEl.value = '';
  }
  nameEl?.addEventListener('input', () => { if (nameErr) nameErr.hidden = true; });

  // Collect the personalization note (custom fields or the single name box).
  function collectNote(): { ok: boolean; note: string } {
    const free = (orderNoteEl?.value || '').trim();
    const withFree = (n: string) => [n, free && 'Order note: ' + free].filter(Boolean).join(' · ');
    if (hasCustomFields) {
      const parts: string[] = []; let missing: HTMLInputElement | null = null;
      for (const inp of cfInputs) { const v = (inp.value || '').trim(); if (inp.dataset.required && !v) { if (!missing) missing = inp; continue; } if (v) parts.push((inp.dataset.label || '') + ': ' + v); }
      if (missing) { if (cfErr) cfErr.hidden = false; missing.focus(); return { ok: false, note: '' }; }
      return { ok: true, note: withFree(parts.join(' · ')) };
    }
    if (personalizeEl && !personalizeEl.hidden) { const nm = (nameEl?.value || '').trim(); if (!nm) { if (nameErr) nameErr.hidden = false; nameEl?.focus(); return { ok: false, note: '' }; } return { ok: true, note: withFree(nm) }; }
    return { ok: true, note: withFree('') };
  }

  // Colour → image: if a chosen option value has a mapped image, swap the gallery main.
  // Fiyatlar gizliyken satın alma yok: WhatsApp mesajını müşterinin yazdığı not
  // ve seçtiği varyantlarla canlı güncelle, böylece tek dokunuşla gönderebilsin.
  const NL = String.fromCharCode(10); // satır sonu — WhatsApp mesajını satırlara böler
  const waBtn = document.getElementById('wa-btn') as HTMLAnchorElement | null;
  if (waBtn) {
    const rebuild = () => {
      const t = waBtn.dataset.title || '';
      const u = waBtn.dataset.url || location.href;
      const chosen = sels.filter((x) => x.value).map((x) => `${x.dataset.name}: ${x.value}`).join(', ');
      const note = (orderNoteEl?.value || '').trim();
      const lines = [
        `Hello! Could I get the price for "${t}"?`,
        chosen && `Options: ${chosen}`,
        note && `My request: ${note}`,
        u,
      ].filter(Boolean);
      waBtn.href = 'https://wa.me/905067927685?text=' + encodeURIComponent(lines.join(NL));
    };
    orderNoteEl?.addEventListener('input', rebuild);
    sels.forEach((x) => x.addEventListener('change', rebuild));
    rebuild();
  }

  const galleryMain = document.getElementById('gallery-main') as HTMLImageElement | null;
  function updateColorImage() {
    if (!galleryMain || !prod.optionImages) return;
    for (const s of sels) { const url = prod.optionImages[s.value]; if (url) { galleryMain.src = url; return; } }
  }

  sels.forEach((s) => s.addEventListener('change', () => { if (errEl) errEl.hidden = true; refreshPrice(); updatePersonalize(); updateColorImage(); }));
  refreshPrice();
  updatePersonalize();
  updateColorImage();

  function render() { if (valEl) valEl.textContent = String(qty); if (minus) (minus as HTMLButtonElement).disabled = qty <= 1; }
  minus?.addEventListener('click', () => { if (qty > 1) { qty--; render(); } });
  plus?.addEventListener('click', () => { if (qty < 99) { qty++; render(); } });
  render();

  btn?.addEventListener('click', () => {
    if (sels.length && !allChosen()) {
      if (errEl) errEl.hidden = false;
      const firstEmpty = sels.find((s) => !s.value);
      firstEmpty?.focus();
      return;
    }
    const nr = collectNote();
    if (!nr.ok) return;
    const opts = sels.length ? selected() : undefined;
    addToCart(prod, qty, opts, nr.note || undefined);
    showCartToast({ addedLabel: 'Added to cart', goLabel: 'Go to cart', cartHref: '/en/cart' });
  });
</script>

  <style>
    .detail-section { padding-top: var(--space-6); }
    .crumbs { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: var(--step-small); color: var(--muted); margin-bottom: var(--space-5); }
    .crumbs a { color: var(--muted); transition: color var(--dur) var(--ease); }
    .crumbs a:hover { color: var(--accent); }
    .crumbs span[aria-hidden] { opacity: .5; }
    .crumbs__current { color: var(--ink); font-weight: 500; max-width: 46ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .detail { display: grid; grid-template-columns: 1.05fr 1fr; gap: var(--space-7); align-items: start; }
    .detail__info { position: sticky; top: 96px; }
    .detail__eyebrow { font-family: var(--font-body); font-size: var(--step-small); letter-spacing: .16em; text-transform: uppercase; color: var(--accent); margin: 0 0 var(--space-2); }
    .detail__title { font-family: var(--font-display); font-size: clamp(1.8rem, 3.2vw, 2.6rem); line-height: 1.12; margin: 0 0 var(--space-3); }
    .detail__meta { display: flex; align-items: center; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-4); }

    .buybox { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); padding: var(--space-5); box-shadow: var(--shadow-glass); }
    .leadtime { display: flex; align-items: flex-start; gap: 9px; font-size: .88rem; line-height: 1.5;
      color: var(--ink); margin: 0 0 var(--space-4); padding: 11px 14px; border-radius: var(--radius);
      background: color-mix(in srgb, var(--accent) 7%, var(--surface));
      border: 1px solid color-mix(in srgb, var(--accent) 26%, var(--line)); }
    .leadtime svg { flex-shrink: 0; margin-top: 2px; color: var(--accent-ink); }
    .leadtime strong { color: var(--accent-ink); }
    .buybox__pricerow { display: flex; align-items: baseline; gap: var(--space-3); flex-wrap: wrap; }

    .variations { display: flex; flex-direction: column; gap: var(--space-3); margin: var(--space-4) 0; }
    .dmbuy { display: flex; flex-direction: column; gap: 10px; margin: var(--space-4) 0; }
    .dmbuy__row { display: flex; gap: 10px; flex-wrap: wrap; }
    /* Buton etiketi tipografisi:
       - line-height 1: etiket tek satır, dikey ortalama flex + min-height ile
         yapılıyor. Gövdeden miras 1.7 görünmez bir dikey şişkinlik bırakıyordu.
       - letter-spacing -.011em: Inter 600 ağırlıkta bu boyutta optik olarak
         dağınık duruyor; hafif sıkı tracking etiketi tek bir blok gibi okutuyor.
       - nowrap: "WhatsApp’tan" gibi marka adları satır sonunda asla bölünmemeli. */
    .dmbuy__btn { flex: 1 1 180px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 54px; padding: 0 20px; border-radius: var(--radius-pill); font-family: inherit; font-size: .95rem; font-weight: 600; line-height: 1; letter-spacing: -.011em; white-space: nowrap; text-decoration: none; border: 1.5px solid transparent; transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease), background var(--dur) var(--ease), border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
    .dmbuy__btn > svg { flex-shrink: 0; }
    /* ── Dikiş imzası ────────────────────────────────────────────────
       Butonun kenarına, sitenin başlık ayraçlarındaki (stroke-dasharray)
       aynı dikiş ritmi işleniyor: düz bir çerçeve yerine iplikle çevrilmiş
       bir kenar. Her butonun hover'ı gerçek bir dikiş hareketinden geliyor:
         • WhatsApp (birincil): dikiş İŞLENİYOR — teyel ilerliyor.
         • Instagram (ikincil): dikiş SIKILAŞIYOR — aralar kapanıyor, renk
           Instagram moruna dönüyor.
       SVG rect'in geometrisi CSS'ten veriliyor, böylece buton genişliği ne
       olursa olsun dikiş aralığı sabit kalıyor. */
    .dmbuy__btn { position: relative; overflow: visible; }
    .seam { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; overflow: visible; }
    .seam rect { x: 2px; y: 2px; width: calc(100% - 4px); height: calc(100% - 4px); rx: 25px;
      fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round;
      stroke-dasharray: 5 4.5; opacity: .3;
      transition: opacity var(--dur) var(--ease), stroke-dasharray var(--dur) var(--ease), stroke var(--dur) var(--ease); }

    /* Birincil: teyel ilerliyor */
    @keyframes seam-run { to { stroke-dashoffset: -19; } }
