---
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { loadProducts } from '@lib/products';
import { buildHaystack } from '@lib/search';
import { categoryLabel, categorySlug } from '@lib/categories';

const products = loadProducts();
// Precompute each product's searchable text at build time so the browser only
// has to fold the query — no product JSON is shipped to the client.
const items = products.map((p) => ({ p, h: buildHaystack(p) }));
const cats = [...new Set(products.map((p) => p.category))].slice(0, 8);
---
<Base locale="en" title="Search Products — Handmade Crochet Toys | Aselovers"
  description="Search the Aselovers catalogue: amigurumi toys, crochet dolls, sleep companions, curtain tiebacks and baby gifts."
  pathSelf="search" pathsAlt={{ tr: 'arama', en: 'search' }} noindex>
  <Nav locale="en" />
  <main>
    <section class="section">
      <div class="container">

        <div class="searchhead">
          <p class="eyebrow">Search the Catalogue</p>
          <h1 class="searchhead__title">What are you looking for?</h1>
          <form class="searchbox" id="searchform" role="search" action="/en/search" method="get">
            <svg class="searchbox__icon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input class="searchbox__input" id="q" name="q" type="search" autocomplete="off"
              placeholder="Bunny, giraffe, sleep companion, baby gift…" aria-label="Search products" />
            <button class="searchbox__clear" id="clear" type="button" hidden aria-label="Clear search">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </form>

          <div class="chips">
            <span class="chips__label">Popular:</span>
            {cats.map((c) => (
              <a class="chip" href={`/en/products/${categorySlug(c, 'en')}`}>{categoryLabel(c, 'en')}</a>
            ))}
          </div>
        </div>

        <p class="toolbar__count" id="result-count" aria-live="polite">{products.length} products</p>

        <div class="grid" id="grid">
          {items.map(({ p, h }) => (
            <div class="grid__item" data-h={h}><ProductCard product={p} locale="en" quickAdd /></div>
          ))}
        </div>

        <div class="noresults" id="noresults" hidden>
          <p class="noresults__title">No products matched your search.</p>
          <p class="noresults__sub">Check the spelling or try a shorter word — for example “bunny” or “baby”.</p>
          <a class="btn btn--primary" href="/en/products">Browse all products</a>
        </div>
      </div>
    </section>
  </main>
  <Footer locale="en" />

  <style>
    .searchhead { text-align: center; max-width: 640px; margin: 0 auto var(--space-6); }
    .searchhead__title { font-family: var(--font-display); font-size: clamp(1.9rem, 4vw, 2.8rem); margin: 0 0 var(--space-4); }
    .eyebrow { justify-content: center; }

    .searchbox { position: relative; display: flex; align-items: center; }
    .searchbox__icon { position: absolute; left: 18px; color: var(--muted); pointer-events: none; }
    .searchbox__input { width: 100%; font: inherit; font-size: 1rem; padding: 15px 46px 15px 50px; border: 1.5px solid var(--line); border-radius: var(--radius-pill); background: var(--surface); color: var(--ink); transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
    .searchbox__input::placeholder { color: var(--muted); }
    .searchbox__input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 14%, transparent); }
    .searchbox__input::-webkit-search-cancel-button { display: none; }
    .searchbox__clear { position: absolute; right: 14px; display: grid; place-items: center; width: 28px; height: 28px; border: none; border-radius: 50%; background: var(--section); color: var(--muted); cursor: pointer; transition: color var(--dur) var(--ease), background var(--dur) var(--ease); }
    .searchbox__clear:hover { background: var(--line); color: var(--ink); }

    .chips { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: var(--space-2); margin-top: var(--space-4); }
    .chips__label { font-size: var(--step-small); color: var(--muted); }
    .chip { font-size: .85rem; padding: 6px 14px; border: 1px solid var(--line); border-radius: var(--radius-pill); color: var(--muted); text-decoration: none; transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease); }
    .chip:hover { border-color: var(--accent); color: var(--accent-ink); }

    .toolbar__count { font-size: var(--step-small); color: var(--muted); font-feature-settings: "tnum"; margin: 0 0 var(--space-5); }

    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-6) var(--space-5); }
    .grid__item[hidden] { display: none; }

    .noresults { text-align: center; padding: var(--space-8) 0; }
    .noresults__title { font-weight: 600; margin: 0 0 var(--space-2); }
    .noresults__sub { color: var(--muted); margin: 0 0 var(--space-5); }
  </style>

  <script>
    import { addToCart, showCartToast } from '@lib/cart';
    import type { Product } from '@lib/products';
    import { queryTerms, scoreHaystack } from '@lib/search';

    const input = document.getElementById('q') as HTMLInputElement;
    const form = document.getElementById('searchform') as HTMLFormElement;
    const clearBtn = document.getElementById('clear') as HTMLButtonElement;
    const grid = document.getElementById('grid')!;
    const countEl = document.getElementById('result-count')!;
    const noResults = document.getElementById('noresults')!;
    const items = Array.from(grid.querySelectorAll<HTMLElement>('.grid__item'));

    function apply(query: string) {
      const terms = queryTerms(query);
      clearBtn.hidden = query.trim() === '';

      // Blank query shows the whole catalogue in its original order — a search
      // page that greets you with "no results" is a dead end.
      if (terms.length === 0) {
        items.forEach((it) => { it.hidden = false; grid.appendChild(it); });
        countEl.textContent = `${items.length} products`;
        noResults.hidden = true;
        return;
      }

      const scored = items.map((it) => ({ it, score: scoreHaystack(it.dataset.h || '', terms) }));
      const hits = scored.filter((s) => s.score > 0).sort((a, b) => b.score - a.score);

      scored.forEach(({ it, score }) => { it.hidden = score === 0; });
      hits.forEach(({ it }) => grid.appendChild(it));

      countEl.textContent = hits.length === 1 ? '1 product found' : `${hits.length} products found`;
      noResults.hidden = hits.length > 0;
    }

    // Keep the URL shareable/bookmarkable without adding a history entry per keystroke.
    function syncUrl(query: string) {
      const url = new URL(location.href);
      if (query.trim()) url.searchParams.set('q', query.trim());
      else url.searchParams.delete('q');
      history.replaceState(null, '', url);
    }

    let timer: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => { apply(input.value); syncUrl(input.value); }, 120);
    });

    // Submitting would reload the page; we already filter live.
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      clearTimeout(timer);
      apply(input.value);
      syncUrl(input.value);
    });

    clearBtn.addEventListener('click', () => {
      input.value = '';
      apply('');
      syncUrl('');
      input.focus();
    });

    // Back/forward between searches.
    addEventListener('popstate', () => {
      input.value = new URL(location.href).searchParams.get('q') ?? '';
      apply(input.value);
    });

    const initial = new URL(location.href).searchParams.get('q') ?? '';
    input.value = initial;
    apply(initial);
    if (!initial) input.focus();

    grid.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.card__add') as HTMLButtonElement | null;
      if (!btn) return;
      e.preventDefault();
      const id = btn.getAttribute('data-id');
      if (!id) return;
      // Products with variations must be configured on the product page — quick-add
      // would otherwise create an order with no color/size and the wrong price.
      if (btn.getAttribute('data-opts')) {
        const href = btn.getAttribute('data-href');
        if (href) { window.location.href = href; return; }
      }
      addToCart({ id } as Product, 1);
      showCartToast({ addedLabel: 'Added to cart', goLabel: 'Go to cart', cartHref: '/en/cart' });
    });
  </script>
</Base>
