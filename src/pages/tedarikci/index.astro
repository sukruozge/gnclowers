    .sup-h1 { font-size: clamp(1.7rem, 3vw, 2.3rem); margin-bottom: 6px; }
    .sup-loading, .sup-empty { color: var(--muted); text-align: center; padding: 48px 0; }

    /* giriş */
    .sup-login { max-width: 440px; margin: 6vh auto 0; background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 36px 32px; }
    .sup-login__title { font-size: 1.9rem; margin-bottom: 10px; }
    .sup-login__lead { color: var(--muted); font-size: .95rem; margin-bottom: 24px; }
    .sup-login__help { color: var(--muted); font-size: .82rem; margin: 18px 0 0; }
    .sup-form { display: grid; gap: 14px; }
    .sup-btn-wide { width: 100%; }

    /* alanlar */
    .sup-field { display: grid; gap: 6px; font-size: .85rem; color: var(--muted); }
    .sup-field input, .sup-field textarea, .sup-yarn input, .sup-search {
      font: inherit; font-size: .95rem; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; width: 100%;
      transition: border-color .15s, box-shadow .15s;
    }
    .sup-field input:focus, .sup-field textarea:focus, .sup-yarn input:focus, .sup-search:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent); }
    .sup-field textarea { resize: vertical; line-height: 1.55; }
    .sup-error { color: #b3261e; font-size: .85rem; margin: 0; }
    .sup-error[hidden] { display: none; }
    .sup-hint { color: var(--muted); font-size: .85rem; margin: 0 0 14px; }

    /* liste */
    .sup-list-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 24px; flex-wrap: wrap; margin-bottom: 24px; }
    .sup-progress { color: var(--muted); font-size: .9rem; margin: 0; }
    .sup-toolbar { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; }
    .sup-search { min-width: 240px; width: auto; }
    .sup-seg { display: inline-flex; border: 1px solid var(--line); border-radius: 999px; padding: 3px; background: var(--surface); }
    .sup-seg__btn { border: 0; background: none; font: inherit; font-size: .85rem; padding: 7px 14px; border-radius: 999px; cursor: pointer; color: var(--muted); }
    .sup-seg__btn.active { background: var(--ink); color: var(--bg); }
    .sup-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 16px; }
    .sup-item { display: flex; flex-direction: column; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; transition: transform .15s, box-shadow .15s; }
    .sup-item:hover { transform: translateY(-2px); box-shadow: 0 10px 28px -16px rgba(28, 26, 24, .35); }
    .sup-item__img { aspect-ratio: 1; background: var(--section); display: block; }
    .sup-item__img img { width: 100%; height: 100%; object-fit: cover; }
    .sup-item__body { display: grid; gap: 8px; padding: 12px 14px 14px; }
    .sup-item__title { font-size: .92rem; font-weight: 500; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .sup-badge { justify-self: start; font-size: .72rem; letter-spacing: .04em; padding: 3px 9px; border-radius: 999px; border: 1px solid transparent; }
    .sup-badge--empty { color: var(--muted); border-color: var(--line); }
    .sup-badge--draft { color: #8a5a00; background: #fff4dc; }
    .sup-badge--done { color: #1f6b3a; background: #e3f4e8; }

    /* form */
    .sup-back { display: inline-block; margin-bottom: 18px; color: var(--muted); font-size: .9rem; }
    .sup-formwrap { display: grid; grid-template-columns: 300px 1fr; gap: 28px; align-items: start; }
    .sup-product { position: sticky; top: 84px; }
    .sup-product__img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 14px; margin-bottom: 16px; }
    .sup-product__title { font-size: 1.35rem; margin-bottom: 6px; }
    .sup-product__meta { color: var(--muted); font-size: .85rem; }
    .sup-spec { display: grid; gap: 18px; }
    .sup-card { border: 1px solid var(--line); border-radius: 16px; background: var(--surface); padding: 20px 22px 22px; margin: 0; min-width: 0; }
    .sup-card legend { font-family: var(--font-display); font-size: 1.1rem; padding: 0 8px; }
    .sup-two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .sup-yarns { display: grid; gap: 8px; }
    .sup-yarn { display: grid; grid-template-columns: 1.1fr 1.3fr .8fr 1fr 1fr .8fr 32px; gap: 6px; align-items: center; }
    .sup-yarn input { padding: 8px 10px; font-size: .88rem; }
    .sup-yarn__del { border: 0; background: none; color: var(--muted); font-size: 1.3rem; cursor: pointer; line-height: 1; }
    .sup-yarn__del:hover { color: #b3261e; }
    .sup-add { margin-top: 12px; }
    .sup-file__current { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--section); }
    .sup-file__actions { display: flex; gap: 14px; }
    .sup-drop { display: block; border: 2px dashed var(--line); border-radius: 12px; padding: 26px; text-align: center; color: var(--muted); cursor: pointer; font-size: .92rem; transition: border-color .15s, background .15s; }
    .sup-drop.over, .sup-drop:hover { border-color: var(--accent); background: var(--section); }
    .sup-drop[hidden] { display: none; }
    .sup-save { display: grid; gap: 12px; padding: 4px 2px 0; }
    .sup-check { display: flex; align-items: center; gap: 10px; font-size: .95rem; }
    .sup-check input { width: 18px; height: 18px; accent-color: var(--accent); }
    .sup-save__row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .sup-updated { color: var(--muted); font-size: .85rem; }

    .sup-toast { position: fixed; left: 50%; bottom: 28px; transform: translate(-50%, 20px); opacity: 0; background: var(--ink); color: var(--bg); padding: 11px 18px; border-radius: 999px; font-size: .9rem; pointer-events: none; transition: opacity .2s, transform .2s; z-index: 20; }
    .sup-toast.show { opacity: 1; transform: translate(-50%, 0); }
    .sup-toast.ok { background: #1f6b3a; }
    .sup-toast.err { background: #b3261e; }

    @media (max-width: 860px) {
      .sup-formwrap { grid-template-columns: 1fr; }
      .sup-product { position: static; display: grid; grid-template-columns: 96px 1fr; gap: 14px; align-items: center; }
      .sup-product__img { margin: 0; }
      .sup-product .eyebrow { display: none; }
      .sup-yarn { grid-template-columns: 1fr 1fr; }
      .sup-yarn__del { grid-column: 2; justify-self: end; }
      .sup-two { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .sup-main { padding: 20px 16px 80px; }
      .sup-login { padding: 28px 20px; margin-top: 2vh; }
      .sup-search { min-width: 0; width: 100%; }
    }
  </style>
